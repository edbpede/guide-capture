# Copy to private/.env and fill in real values. Keep that file at mode 600.
#
#     mkdir -p private && cp .env.example private/.env && chmod 600 private/.env
#
# private/ is gitignored in full. Never commit real values, and never pass them as
# command-line arguments — the login-* and unlock-* commands read this file directly.

# Employee login for the municipal education-service identity provider (see
# docs/login-flow-ishoj.md). Used only by `bin/guide-capture login-ishoj android`.
I_ACC_EMAIL=name@example.invalid
I_ACC_PASS=replace-me

# Six-digit OS2faktor app PIN. Used only by `bin/guide-capture unlock-os2faktor android`.
OS2FAKTOR_PIN=000000

# Optional override, exported in your shell rather than set here.
#
# Relocate the private tree off the repository entirely:
# GUIDE_CAPTURE_PRIVATE=/absolute/path/to/private
