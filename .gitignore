# Everything private lives in exactly one place: the workspace .env, the multi-gigabyte Android
# runtime tree, and reviewed output awaiting curation. Nothing under private/ is ever published.
private/

# Local tooling and editor state
.omc/
.DS_Store
*.pyc
__pycache__/

# Defence in depth. private/ already covers these, but a stray copy anywhere else in the tree
# must never become committable either.
.env
.env.*
!.env.example
*.age
*.avd/
*.keystore
*.jks
*.p12
auth-state*
current-run.json
runtime/
raw-captures/
